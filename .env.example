# WargaKu - Environment Variables
# PENTING: file ini dibaca Vite hanya jika berada di ROOT project (sejajar package.json).
# Nilai diakses via import.meta.env.VITE_* — restart `npm run dev` setelah mengubah.

VITE_APP_NAME=WargaKu
VITE_APP_RT=RT 04 / RW 08
VITE_APP_KELURAHAN=Kelurahan Sukamaju
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_VERSION=0.0.0

# --- Supabase (isi dari Dashboard → Settings → API) ---
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-dari-dashboard-supabase
